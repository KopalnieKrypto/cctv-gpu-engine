# The box's Cloudflare Tunnel to zone-annotator (gpu-exchange#298), installed by install-annotator.sh.
# The token never reaches argv: systemd hands the root-only file to a throwaway user as a credential.
[Unit]
Description=Cloudflare Tunnel for zone-annotator
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
DynamicUser=yes
LoadCredential=tunnel-token:/etc/zone-annotator/tunnel.token
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run --token-file %d/tunnel-token
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
